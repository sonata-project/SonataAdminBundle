{% if admin.isAclEnabled()
    and object is not null
    and admin.id(object) is not null
    and admin.hasAccess('acl', object)
    and admin.hasRoute('acl')
%}
    <a class="admin-btn-ghost" href="{{ admin.generateObjectUrl('acl', object) }}">
        {{ ux_icon('lucide:shield-check', {class: 'w-4 h-4'}) }}
        {{ 'link_action_acl'|trans({}, 'SensioLabsAdminBundle') }}
    </a>
{% endif %}
