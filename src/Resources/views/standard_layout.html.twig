{%- set _preview = block('preview') is defined ? block('preview')|trim : null %}
{% set _form = block('form') is defined ? block('form')|trim : null %}
{% set _show = block('show') is defined ? block('show')|trim : null %}
{% set _list_table = block('list_table') is defined ? block('list_table')|trim : null %}
{% set _list_filters = block('list_filters') is defined ? block('list_filters')|trim : null %}
{% set _tab_menu = block('tab_menu') is defined ? block('tab_menu')|trim : null %}
{% set _content = block('content') is defined ? block('content')|trim : null %}
{% set _title = block('title') is defined ? block('title')|trim : null %}
{% set _breadcrumb = block('breadcrumb') is defined ? block('breadcrumb')|trim : null %}
{% set _actions = block('actions') is defined ? block('actions')|trim : null %}
{% set _navbar_title = block('navbar_title') is defined ? block('navbar_title')|trim : null %}
{% set _list_filters_actions = block('list_filters_actions') is defined ? block('list_filters_actions')|trim : null -%}
{% set _use_select2 = sensiolabs_config.getOption('use_select2') %}

<!DOCTYPE html>
<html {% block html_attributes %}lang="en" class="no-js"{% endblock %}>
    <head>
        {% block meta_tags %}
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <meta http-equiv="X-UA-Compatible" content="IE=edge">
        {% endblock %}

        <meta name="sensiolabs-config" content='{{ {
            CONFIRM_EXIT: sensiolabs_config.getOption('confirm_exit'),
            USE_SELECT2: _use_select2,
            USE_STICKYFORMS: sensiolabs_config.getOption('use_stickyforms'),
            DEBUG: sensiolabs_config.getOption('js_debug'),
        }|json_encode()|raw }}'
        >
        <meta name="sensiolabs-translations" content='{{ {
            CONFIRM_EXIT: 'confirm_exit'|trans({}, 'SensioLabsAdminBundle'),
        }|json_encode()|raw }}'
        >

        {% block stylesheets %}
            {% for stylesheet in sensiolabs_config.getOption('stylesheets', []) %}
                <link rel="stylesheet" href="{{ asset(stylesheet.path, stylesheet.package_name) }}">
            {% endfor %}
        {% endblock %}

        {% block javascripts %}
            {% block sensiolabs_javascript_config %}
            {% endblock %}

            {% block sensiolabs_javascript_pool %}
                {{ importmap('app') }}

                {% for javascript in sensiolabs_config.getOption('javascripts', []) %}
                    <script src="{{ asset(javascript.path, javascript.package_name) }}"></script>
                {% endfor %}
            {% endblock %}
        {% endblock %}

        <title>
        {% block sensiolabs_head_title %}
            {{ 'Admin'|trans({}, 'SensioLabsAdminBundle') }}
            {% if _title is not empty %}
                {{ _title|striptags|raw }}
            {% else %}
                {% if action is defined %}
                    - {{ render_breadcrumbs_for_title(admin, action) }}
                {% endif %}
            {% endif %}
        {% endblock %}
        </title>
    </head>
    <body {% block body_attributes %}class="admin-shell antialiased{% if _use_select2 %} sensiolabs-select2{% endif %}"{% endblock %}
          data-controller="sensiolabs-de--admin-bundle--sidebar"
    >

    {# Mobile overlay #}
    <div class="admin-sidebar-overlay hidden" data-sensiolabs-de--admin-bundle--sidebar-target="overlay" data-action="click->sensiolabs-de--admin-bundle--sidebar#close"></div>

    {% block sensiolabs_left_side %}
        <aside class="admin-sidebar" id="admin-sidebar" data-sensiolabs-de--admin-bundle--sidebar-target="sidebar">
            {% block sensiolabs_sidebar_header %}
                <div class="admin-sidebar-header">
                    {% block logo %}
                        <a href="{{ path('sensiolabs_admin_dashboard') }}" class="admin-sidebar-brand">
                            {% if 'icon' == sensiolabs_config.getOption('logo_content') or 'all' == sensiolabs_config.getOption('logo_content') %}
                                <img src="{{ asset(sensiolabs_config.logo) }}" alt="{{ sensiolabs_config.title }}" class="admin-sidebar-brand-logo">
                            {% endif %}
                            {% if 'text' == sensiolabs_config.getOption('logo_content') or 'all' == sensiolabs_config.getOption('logo_content') %}
                                <span class="truncate">{{ sensiolabs_config.title }}</span>
                            {% endif %}
                        </a>
                    {% endblock %}
                </div>
            {% endblock %}

            <nav class="admin-sidebar-nav" data-controller="sensiolabs-de--admin-bundle--treeview">
                {% block sensiolabs_side_nav %}
                    {% block side_bar_before_nav %} {% endblock %}
                    {% block side_bar_nav %}
                        {% for item in sensiolabs_admin_menu_items() %}
                            {% if item.isSection() %}
                                <div class="admin-sidebar-section">
                                    <div class="admin-sidebar-section-title">
                                        {{ item.label|trans({}, 'SensioLabsAdminBundle') }}
                                    </div>
                                    <ul class="admin-sidebar-menu">
                            {% elseif item.isSubMenu() %}
                                        <li class="treeview" data-sensiolabs-de--admin-bundle--treeview-target="item">
                                            <a href="#" class="admin-sidebar-item group" data-action="click->sensiolabs-de--admin-bundle--treeview#toggle">
                                                {% if item.icon %}
                                                    <span class="admin-sidebar-item-icon">{{ item.icon|parse_icon|raw }}</span>
                                                {% endif %}
                                                <span class="flex-1">{{ item.label|trans({}, 'SensioLabsAdminBundle') }}</span>
                                                <svg class="w-4 h-4 transition-transform duration-200 treeview-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                                </svg>
                                            </a>
                                            <ul class="admin-sidebar-submenu hidden" data-sensiolabs-de--admin-bundle--treeview-target="submenu">
                                                {% for child in item.children %}
                                                    <li>
                                                        <a href="{{ sensiolabs_admin_menu_item_url(child) }}" class="admin-sidebar-submenu-item">
                                                            {{ child.label|trans({}, 'SensioLabsAdminBundle') }}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </li>
                            {% else %}
                                        <li>
                                            <a href="{{ sensiolabs_admin_menu_item_url(item) }}" class="admin-sidebar-item">
                                                {% if item.icon %}
                                                    <span class="admin-sidebar-item-icon">{{ item.icon|parse_icon|raw }}</span>
                                                {% endif %}
                                                <span>{{ item.label|trans({}, 'SensioLabsAdminBundle') }}</span>
                                            </a>
                                        </li>
                            {% endif %}
                        {% endfor %}
                                    </ul>
                                </div>
                    {% endblock side_bar_nav %}
                    {% block side_bar_after_nav %}{% endblock %}
                {% endblock sensiolabs_side_nav %}
            </nav>

            {% block sensiolabs_sidebar_footer %}
                <div class="admin-sidebar-footer">
                    <div class="text-xs text-sidebar-text-muted text-center">
                        {% block side_bar_after_nav_content %}{% endblock %}
                    </div>
                </div>
            {% endblock %}
        </aside>
    {% endblock sensiolabs_left_side %}

    <div class="admin-main">
        {% block sensiolabs_header %}
            <header class="admin-header">
                {% block sensiolabs_header_noscript_warning %}
                    <noscript>
                        <div class="noscript-warning">
                            {{ 'noscript_warning'|trans({}, 'SensioLabsAdminBundle') }}
                        </div>
                    </noscript>
                {% endblock %}

                <button type="button" class="admin-sidebar-toggle" title="{{ 'toggle_navigation'|trans({}, 'SensioLabsAdminBundle') }}" data-action="click->sensiolabs-de--admin-bundle--sidebar#toggle">
                    <span class="sr-only">{{ 'toggle_navigation'|trans({}, 'SensioLabsAdminBundle') }}</span>
                    {{ ux_icon('lucide:menu', {class: 'w-6 h-6'}) }}
                </button>

                <div class="admin-header-left">
                    {% block sensiolabs_breadcrumb %}
                        {% if _breadcrumb is not empty or action is defined %}
                            <nav class="admin-breadcrumb hidden md:flex">
                                {% if _breadcrumb is empty %}
                                    {% if action is defined %}
                                        {{ render_breadcrumbs(admin, action) }}
                                    {% endif %}
                                {% else %}
                                    {{ _breadcrumb|raw }}
                                {% endif %}
                            </nav>
                        {% endif %}
                    {% endblock sensiolabs_breadcrumb %}
                </div>

                {% block sensiolabs_top_nav_menu %}
                    <div class="admin-header-right">
                        {% block sensiolabs_top_nav_menu_add_block %}
                            {% set addBlock = include(get_global_template('add_block')) %}
                            {% if addBlock|trim is not empty %}
                                <div class="admin-dropdown" data-controller="sensiolabs-de--admin-bundle--dropdown">
                                    <button type="button" data-action="click->sensiolabs-de--admin-bundle--dropdown#toggle" data-sensiolabs-de--admin-bundle--dropdown-target="button" class="admin-btn-ghost admin-btn-icon-sm">
                                        {{ ux_icon('lucide:plus', {class: 'w-5 h-5'}) }}
                                    </button>
                                    <div class="admin-dropdown-menu hidden" data-sensiolabs-de--admin-bundle--dropdown-target="menu">
                                        <div class="admin-dropdown-menu-body">
                                            {{ addBlock|raw }}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endblock %}
                        {% if app.user %}
                            {% block sensiolabs_top_nav_menu_user_block %}
                                {% set userBlock = include(get_global_template('user_block')) %}
                                {% if userBlock|trim is not empty %}
                                    <div class="admin-dropdown" data-controller="sensiolabs-de--admin-bundle--dropdown">
                                        <button type="button" data-action="click->sensiolabs-de--admin-bundle--dropdown#toggle" data-sensiolabs-de--admin-bundle--dropdown-target="button" class="admin-btn-ghost admin-btn-icon-sm">
                                            <span class="admin-avatar admin-avatar-sm bg-primary-100 text-primary-600">
                                                {{ ux_icon('lucide:user', {class: 'w-4 h-4'}) }}
                                            </span>
                                        </button>
                                        <div class="admin-dropdown-menu hidden" data-sensiolabs-de--admin-bundle--dropdown-target="menu">
                                            <div class="admin-dropdown-menu-body">
                                                {{ userBlock|raw }}
                                            </div>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endblock %}
                        {% endif %}
                    </div>
                {% endblock %}
            </header>
        {% endblock sensiolabs_header %}

        {% block sensiolabs_wrapper %}
            <main>
                {% block sensiolabs_page_content %}
                    {% block sensiolabs_page_content_header %}
                        {% block sensiolabs_page_content_nav %}
                            {% if _navbar_title is not empty
                              or _tab_menu is not empty
                              or _actions is not empty
                              or _list_filters_actions is not empty
                             %}
                                <div class="bg-white border-b border-gray-200 px-6 py-4">
                                    <div class="flex flex-wrap items-center gap-4">
                                        {# Left side: Title and primary action (Create button) #}
                                        <div class="flex items-center gap-4 flex-1 min-w-0">
                                            {% block tab_menu_navbar_header %}
                                                {% if _navbar_title is not empty %}
                                                    <h1 class="admin-content-title truncate">{{ _navbar_title|raw }}</h1>
                                                {% endif %}
                                            {% endblock %}

                                            {# Primary action: Create button - most important action goes here #}
                                            {% if admin is defined and action is defined and action == 'list' %}
                                                {% if admin.hasAccess('create') and admin.hasRoute('create') %}
                                                    {% if admin.subClasses is empty %}
                                                        <a class="inline-flex items-center justify-center gap-2 h-10 px-4 text-sm font-medium rounded-lg bg-primary-500 text-white hover:bg-primary-600 transition-colors shadow-sm" href="{{ admin.generateUrl('create') }}">
                                                            {{ ux_icon('lucide:plus', {class: 'w-4 h-4'}) }}
                                                            {{ 'link_action_create'|trans({}, 'SensioLabsAdminBundle') }}
                                                        </a>
                                                    {% else %}
                                                        <div class="admin-dropdown" data-controller="sensiolabs-de--admin-bundle--dropdown">
                                                            <button type="button"
                                                                    data-action="click->sensiolabs-de--admin-bundle--dropdown#toggle"
                                                                    data-sensiolabs-de--admin-bundle--dropdown-target="button"
                                                                    class="inline-flex items-center justify-center gap-2 h-10 px-4 text-sm font-medium rounded-lg bg-primary-500 text-white hover:bg-primary-600 transition-colors shadow-sm">
                                                                {{ ux_icon('lucide:plus', {class: 'w-4 h-4'}) }}
                                                                {{ 'link_action_create'|trans({}, 'SensioLabsAdminBundle') }}
                                                                {{ ux_icon('lucide:chevron-down', {class: 'w-4 h-4'}) }}
                                                            </button>
                                                            <div class="admin-dropdown-menu hidden"
                                                                 data-sensiolabs-de--admin-bundle--dropdown-target="menu">
                                                                <div class="admin-dropdown-menu-body">
                                                                    {% for subclass in admin.subclasses|keys %}
                                                                        <a class="admin-dropdown-item" href="{{ admin.generateUrl('create', {'subclass': subclass}) }}">
                                                                            {{ ux_icon('lucide:plus-circle', {class: 'w-4 h-4 text-gray-400'}) }}
                                                                            {{ subclass|trans({}, admin.translationdomain) }}
                                                                        </a>
                                                                    {% endfor %}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                {% endif %}
                                            {% endif %}

                                            {% if _tab_menu is not empty %}
                                                <div class="hidden lg:block">
                                                    {{ _tab_menu|raw }}
                                                </div>
                                            {% endif %}
                                        </div>

                                        {# Right side: Secondary actions #}
                                        <div class="flex items-center gap-2">
                                            {# View mode toggle (list/mosaic) #}
                                            {% if admin is defined and action is defined and action == 'list' and admin.listModes|length > 1 %}
                                                <div class="inline-flex rounded-lg border border-gray-200 overflow-hidden shadow-sm" role="group" aria-label="View mode">
                                                    {% for mode, settings in admin.listModes %}
                                                        {% set mode_label = mode == 'list' ? 'List view' : (mode == 'mosaic' ? 'Grid view' : mode|capitalize ~ ' view') %}
                                                        {% set is_active = admin.getListMode() == mode %}
                                                        <a href="{{ admin.generateUrl('list', app.request.query.all|merge({_list_mode: mode})) }}"
                                                           class="inline-flex items-center justify-center w-10 h-10 transition-all duration-150 {% if is_active %}bg-primary-500 text-white shadow-inner{% else %}bg-white text-gray-500 hover:text-gray-700 hover:bg-gray-50{% endif %} {% if not loop.last %}border-r border-gray-200{% endif %}"
                                                           title="{{ mode_label }}"
                                                           aria-label="{{ mode_label }}"
                                                           {% if is_active %}aria-current="true"{% endif %}>
                                                            {% if mode == 'list' %}
                                                                {{ ux_icon('lucide:list', {class: 'w-5 h-5'}) }}
                                                            {% elseif mode == 'mosaic' %}
                                                                {{ ux_icon('lucide:layout-grid', {class: 'w-5 h-5'}) }}
                                                            {% else %}
                                                                {{ ux_icon('lucide:grid-3x3', {class: 'w-5 h-5'}) }}
                                                            {% endif %}
                                                        </a>
                                                    {% endfor %}
                                                </div>
                                            {% endif %}

                                            {# Filters dropdown #}
                                            {% if _list_filters_actions is not empty %}
                                                {{ _list_filters_actions|raw }}
                                            {% endif %}

                                            {# Other action buttons (edit, show, history, etc.) #}
                                            {# Note: Create button is excluded on list view (handled above) #}
                                            {% block sensiolabs_admin_content_actions_wrappers %}
                                                {% set filtered_actions = _actions|replace({ '<li>': '', '</li>': '' })|trim %}
                                                {% if filtered_actions is not empty %}
                                                    <div class="admin-content-actions flex items-center gap-2">
                                                        {{ _actions|raw }}
                                                    </div>
                                                {% endif %}
                                            {% endblock sensiolabs_admin_content_actions_wrappers %}
                                        </div>
                                    </div>

                                    {# Tab menu on mobile - show below header #}
                                    {% if _tab_menu is not empty %}
                                        <div class="lg:hidden mt-3 -mb-1">
                                            {{ _tab_menu|raw }}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endblock sensiolabs_page_content_nav %}
                    {% endblock sensiolabs_page_content_header %}

                    <div class="admin-content">
                        {% block sensiolabs_admin_content %}

                            {% block notice %}
                                {% include '@SonataTwig/FlashMessage/render.html.twig' %}
                            {% endblock notice %}

                            {% if _preview is not empty %}
                                <div class="sensiolabs-ba-preview mb-6">{{ _preview|raw }}</div>
                            {% endif %}

                            {% if _content is not empty %}
                                <div class="sensiolabs-ba-content mb-6">{{ _content|raw }}</div>
                            {% endif %}

                            {% if _show is not empty %}
                                <div class="sensiolabs-ba-show">{{ _show|raw }}</div>
                            {% endif %}

                            {% if _form is not empty %}
                                <div class="sensiolabs-ba-form">{{ _form|raw }}</div>
                            {% endif %}

                            {% if _list_filters is not empty %}
                                <div class="mb-5">
                                    {{ _list_filters|raw }}
                                </div>
                            {% endif %}

                            {% if _list_table is not empty %}
                                <div>
                                    {{ _list_table|raw }}
                                </div>
                            {% endif %}
                        {% endblock sensiolabs_admin_content %}
                    </div>
                {% endblock sensiolabs_page_content %}
            </main>
        {% endblock sensiolabs_wrapper %}
    </div>

    </body>
</html>
