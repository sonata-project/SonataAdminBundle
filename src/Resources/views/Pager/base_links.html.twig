<div class="flex justify-center">
    <nav class="admin-pagination" aria-label="Pagination">
        {% if admin.datagrid.pager.page > 2 %}
            <a href="{{ admin.generateUrl(action, admin.datagrid.paginationparameters(1)) }}"
               title="{{ 'link_first_pager'|trans({}, 'SensioLabsAdminBundle') }}"
               class="admin-pagination-item">
                {{ ux_icon('lucide:chevrons-left', {class: 'w-4 h-4'}) }}
            </a>
        {% endif %}

        {% if admin.datagrid.pager.page != admin.datagrid.pager.previouspage %}
            <a href="{{ admin.generateUrl(action, admin.datagrid.paginationparameters(admin.datagrid.pager.previouspage)) }}"
               title="{{ 'link_previous_pager'|trans({}, 'SensioLabsAdminBundle') }}"
               class="admin-pagination-item">
                {{ ux_icon('lucide:chevron-left', {class: 'w-4 h-4'}) }}
            </a>
        {% endif %}

        {# Set the number of pages to display in the pager #}
        {% for page in admin.datagrid.pager.getLinks(sensiolabs_config.getOption('pager_links')) %}
            {% if page == admin.datagrid.pager.page %}
                <a href="{{ admin.generateUrl(action, admin.datagrid.paginationparameters(page)) }}"
                   class="admin-pagination-item admin-pagination-item-active"
                   aria-current="page">{{ page }}</a>
            {% else %}
                <a href="{{ admin.generateUrl(action, admin.datagrid.paginationparameters(page)) }}"
                   class="admin-pagination-item">{{ page }}</a>
            {% endif %}
        {% endfor %}

        {% if admin.datagrid.pager.page != admin.datagrid.pager.nextpage %}
            <a href="{{ admin.generateUrl(action, admin.datagrid.paginationparameters(admin.datagrid.pager.nextpage)) }}"
               title="{{ 'link_next_pager'|trans({}, 'SensioLabsAdminBundle') }}"
               class="admin-pagination-item">
                {{ ux_icon('lucide:chevron-right', {class: 'w-4 h-4'}) }}
            </a>
        {% endif %}

        {% if admin.datagrid.pager.page != admin.datagrid.pager.lastpage and admin.datagrid.pager.lastpage != admin.datagrid.pager.nextpage %}
            <a href="{{ admin.generateUrl(action, admin.datagrid.paginationparameters(admin.datagrid.pager.lastpage)) }}"
               title="{{ 'link_last_pager'|trans({}, 'SensioLabsAdminBundle') }}"
               class="admin-pagination-item">
                {{ ux_icon('lucide:chevrons-right', {class: 'w-4 h-4'}) }}
            </a>
        {% endif %}
    </nav>
</div>
