{% extends get_admin_template('base_list_field', admin.code) %}

{% set is_editable = field_description.option('editable', false) and admin.hasAccess('edit', object) %}
{% set x_editable_type = field_description.type|sensiolabs_xeditable_type %}

{% block field_span_attributes %}
    {% if is_editable and x_editable_type %}
        {{ parent() }}
        data-source="[{value: 0, text: '{%- trans from 'SensioLabsAdminBundle' %}label_type_no{% endtrans -%}'},{value: 1, text: '{%- trans from 'SensioLabsAdminBundle' %}label_type_yes{% endtrans -%}'}]"
    {% endif %}
{% endblock %}

{% block field %}
    {%- include '@SensioLabsAdmin/CRUD/display_boolean.html.twig' with {
        value: value,
        inverse: field_description.option('inverse'),
    } only -%}
{% endblock %}
