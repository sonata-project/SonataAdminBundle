{% if admin.hasAccess('delete', object) and admin.hasRoute('delete') %}
    {% set button_content = sensiolabs_config.getOption('list_action_button_content') %}
    <a
        href="{{ admin.generateObjectUrl('delete', object, actions.link_parameters|default([])) }}"
        class="inline-flex items-center justify-center gap-1.5 p-2 rounded-lg text-error-600 hover:text-error-700 hover:bg-error-50 transition-colors delete_link"
        title="{{ 'action_delete'|trans({}, 'SensioLabsAdminBundle') }}"
    >
        {% if button_content == 'icon' or button_content == 'all' %}
            {{ ux_icon('lucide:trash-2', {class: 'w-4 h-4'}) }}
        {% endif %}
        {% if button_content == 'text' or button_content == 'all' %}
            <span class="text-sm font-medium">{{ 'action_delete'|trans({}, 'SensioLabsAdminBundle') }}</span>
        {% else %}
            <span class="sr-only">
                {{ 'action_delete'|trans({}, 'SensioLabsAdminBundle') }}
            </span>
        {% endif %}
    </a>
{% endif %}
