{%- apply trim|raw %}
    {% set isTrue = inverse|default(false) ? not value : value %}

    <span class="inline-flex items-center gap-1.5">
        {% if isTrue %}
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-success-100 text-success-600">
                {{ ux_icon('lucide:check', {class: 'w-3 h-3'}) }}
            </span>
            <span class="text-sm font-medium text-success-700">{{ 'label_type_yes'|trans({}, 'SensioLabsAdminBundle') }}</span>
        {% else %}
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-gray-100 text-gray-400">
                {{ ux_icon('lucide:x', {class: 'w-3 h-3'}) }}
            </span>
            <span class="text-sm text-gray-500">{{ 'label_type_no'|trans({}, 'SensioLabsAdminBundle') }}</span>
        {% endif %}
    </span>
{% endapply -%}
