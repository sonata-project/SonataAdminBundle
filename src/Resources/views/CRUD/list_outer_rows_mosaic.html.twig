<!--
This template can be customized to match your needs. You should only extends the template and used the different blocks to customize the view:
    - sensiolabs_mosaic_default_view
    - sensiolabs_mosaic_hover_view
    - sensiolabs_mosaic_description
-->

<tr>
    <td colspan="{{
        app.request.isXmlHttpRequest
            ? admin.list.getElements()|filter(element => element.getOption('ajax_hidden') != true)|length
                - admin.list.has(constant('SensioLabs\\AdminBundle\\Datagrid\\ListMapper::NAME_ACTIONS'))
                - admin.list.has(constant('SensioLabs\\AdminBundle\\Datagrid\\ListMapper::NAME_BATCH'))
            : admin.list.getElements()|length
    }}" class="p-4">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-5">
            {% for object in admin.datagrid.results %}
                {% set meta = admin.getObjectMetadata(object) %}
                {% set mosaic_content %}
                    <div class="relative group">
                        <div class="aspect-square overflow-hidden rounded-xl bg-gray-100 shadow-sm ring-1 ring-gray-200/50 transition-all duration-300 group-hover:shadow-lg group-hover:ring-primary-300/50 group-hover:scale-[1.02]">
                            {#
                                This box will be displayed when the mouse is not on the box
                            #}
                            <div class="h-full w-full relative">
                                {% block sensiolabs_mosaic_background %}
                                    {% set hasImage = meta.image is defined and meta.image is not empty and (meta.isImageAvailable is not defined or meta.isImageAvailable) %}
                                    {% if hasImage %}
                                        {% set metaImage = meta.image %}
                                        {% if not (metaImage starts with 'data:') %}
                                            {% set metaImage = asset(metaImage) %}
                                        {% endif %}
                                        <img src="{{ metaImage }}" alt="{{ meta.title }}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                                    {% else %}
                                        {# SVG placeholder when no image is available #}
                                        <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-50 via-gray-100 to-gray-200">
                                            <svg class="w-16 h-16 text-gray-300" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                                                <circle cx="8.5" cy="8.5" r="2" stroke="currentColor" stroke-width="1.5"/>
                                                <path d="M3 16L8 11L11 14L16 9L21 14V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V16Z" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </div>
                                    {% endif %}
                                {% endblock %}
                                {% block sensiolabs_mosaic_default_view %}
                                    <span class="absolute top-2 right-2 px-2 py-0.5 text-xs font-medium bg-white/90 backdrop-blur-sm text-gray-700 rounded-md shadow-sm">#{{ admin.id(object) }}</span>
                                {% endblock %}
                            </div>

                            {#
                                This box will be displayed when the mouse is on the box
                                You can add more description
                            #}
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/70 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col justify-end p-4">
                                {% block sensiolabs_mosaic_hover_view %}
                                    <div class="transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                                        <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium bg-white/20 backdrop-blur-sm text-white rounded-md mb-2">#{{ admin.id(object) }}</span>
                                        {% if meta.description is defined and meta.description is not empty %}
                                            <p class="text-sm text-white/90 line-clamp-2">{{ meta.description }}</p>
                                        {% endif %}
                                    </div>
                                {% endblock %}
                            </div>
                        </div>

                        <div class="mt-3 flex items-center gap-2">
                            {% if (admin.hasRoute('batch') and batchactions|length > 0) or (admin.hasRoute('export') and admin.hasAccess('export') and export_formats|length) %}
                                <input type="checkbox" name="idx[]" value="{{ admin.id(object) }}" class="admin-form-checkbox sensiolabs-ba-list-field-batch">
                            {% endif %}

                            {% block sensiolabs_mosaic_description %}
                                <span class="text-sm font-medium text-gray-700 truncate">{{ meta.title|u.truncate(40) }}</span>
                            {% endblock %}
                        </div>
                    </div>
                {% endset %}
                <div class="sensiolabs-ba-list-field-batch sensiolabs-ba-list-field" data-object-id="{{ admin.id(object) }}">
                    {% if admin.hasAccess('edit', object) and admin.hasRoute('edit') %}
                        <a class="block hover:opacity-80 transition-opacity"
                           href="{{ admin.generateObjectUrl('edit', object) }}">
                            {{ mosaic_content }}
                        </a>
                    {% elseif admin.hasAccess('show', object) and admin.hasRoute('show') %}
                        <a class="block hover:opacity-80 transition-opacity"
                           href="{{ admin.generateObjectUrl('show', object) }}">
                            {{ mosaic_content }}
                        </a>
                    {% else %}
                        {{ mosaic_content }}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </td>
</tr>
