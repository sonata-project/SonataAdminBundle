{% if admin.hasAccess('history', object) and admin.hasRoute('history') %}
    {% set button_content = sensiolabs_config.getOption('list_action_button_content') %}
    <a
        href="{{ admin.generateObjectUrl('history', object, actions.link_parameters|default([])) }}"
        class="inline-flex items-center justify-center gap-1.5 p-2 rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors view_link"
        title="{{ 'link_action_history'|trans({}, 'SensioLabsAdminBundle') }}"
    >
        {% if button_content == 'icon' or button_content == 'all' %}
            {{ ux_icon('lucide:clock', {class: 'w-4 h-4'}) }}
        {% endif %}
        {% if button_content == 'text' or button_content == 'all' %}
            <span class="text-sm font-medium">{{ 'link_action_history'|trans({}, 'SensioLabsAdminBundle') }}</span>
        {% else %}
            <span class="sr-only">
                {{ 'link_action_history'|trans({}, 'SensioLabsAdminBundle') }}
            </span>
        {% endif %}
    </a>
{% endif %}
