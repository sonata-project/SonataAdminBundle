{#

This code manages the many-to-[one|many] association field popup

#}

{% autoescape false %}

{% set associationadmin = sensiolabs_admin.field_description.associationadmin %}

<!-- edit many association -->

<script type="text/javascript">
(function() {
    var field_dialog_{{ id }} = null;
    var field_dialog_content_{{ id }} = null;
    var field_dialog_title_{{ id }} = null;

    function initialize_popup_{{ id }}() {
        if (!field_dialog_{{ id }}) {
            field_dialog_{{ id }} = document.getElementById('field_dialog_{{ id }}');
            field_dialog_content_{{ id }} = field_dialog_{{ id }}.querySelector('.modal-body');
            field_dialog_title_{{ id }} = field_dialog_{{ id }}.querySelector('.modal-title');

            // Move the dialog as a child of the root element
            document.body.appendChild(field_dialog_{{ id }});

            Admin.log('[{{ id }}|field_dialog] move dialog container as a document child');

            // Setup close handlers
            field_dialog_{{ id }}.querySelectorAll('[data-dismiss="modal"]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    Admin.hideModal(field_dialog_{{ id }});
                });
            });

            // Close on backdrop click
            field_dialog_{{ id }}.addEventListener('click', function(e) {
                if (e.target === field_dialog_{{ id }}) {
                    Admin.hideModal(field_dialog_{{ id }});
                }
            });

            // Close on escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && !field_dialog_{{ id }}.classList.contains('hidden')) {
                    Admin.hideModal(field_dialog_{{ id }});
                }
            });
        }
    }

    // Handle link click in a list
    async function field_dialog_form_list_link_{{ id }}(event) {
        initialize_popup_{{ id }}();

        var target = event.currentTarget;

        if (!target.getAttribute('href') || target.getAttribute('href') === '#') {
            return;
        }

        event.preventDefault();
        event.stopPropagation();

        Admin.log('[{{ id }}|field_dialog_form_list_link] handle link click in a list');

        var element = target.closest('#field_dialog_{{ id }} .sonata-ba-list-field');

        // the user does not click on a row column
        if (!element) {
            Admin.log('[{{ id }}|field_dialog_form_list_link] the user does not click on a row column, make ajax call to retrieve inner html');

            try {
                var response = await fetch(target.getAttribute('href'), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                var html = await response.text();

                Admin.log('[{{ id }}|field_dialog_form_list_link] callback success, attach valid js event');

                field_dialog_content_{{ id }}.innerHTML = html;
                field_dialog_form_list_handle_action_{{ id }}();

                Admin.shared_setup(field_dialog_{{ id }});
            } catch (error) {
                console.error('[{{ id }}|field_dialog_form_list_link] Error:', error);
            }

            return;
        }

        Admin.log('[{{ id }}|field_dialog_form_list_link] the user select one element, update input and hide the modal');

        var input = document.getElementById('{{ id }}');
        input.value = element.getAttribute('objectId');
        input.dispatchEvent(new Event('change', { bubbles: true }));

        Admin.hideModal(field_dialog_{{ id }});
    }

    // Handle actions on the modal list
    function field_dialog_form_list_handle_action_{{ id }}() {
        Admin.log('[{{ id }}|field_dialog_form_list_handle_action] attaching valid js event');

        field_dialog_{{ id }}.querySelectorAll('a').forEach(function(link) {
            link.addEventListener('click', field_dialog_form_list_link_{{ id }});
        });

        field_dialog_{{ id }}.querySelectorAll('form').forEach(function(form) {
            form.addEventListener('submit', async function(event) {
                event.preventDefault();

                Admin.log('[{{ id }}|field_dialog_form_list_handle_action] catching submit event, sending ajax request');

                var formData = new FormData(form);
                formData.append('_xml_http_request', 'true');

                try {
                    var response = await fetch(form.action, {
                        method: form.method || 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    var html = await response.text();

                    Admin.log('[{{ id }}|field_dialog_form_list_handle_action] form submit success, restoring event');

                    field_dialog_content_{{ id }}.innerHTML = html;
                    field_dialog_form_list_handle_action_{{ id }}();

                    Admin.shared_setup(field_dialog_{{ id }});
                } catch (error) {
                    console.error('[{{ id }}|field_dialog_form_list_handle_action] Error:', error);
                }
            });
        });
    }

    // Handle the list link
    async function field_dialog_form_list_{{ id }}(event) {
        initialize_popup_{{ id }}();

        event.preventDefault();
        event.stopPropagation();

        Admin.log('[{{ id }}|field_dialog_form_list] open the list modal');

        var a = event.currentTarget;
        field_dialog_content_{{ id }}.innerHTML = '';

        try {
            var response = await fetch(a.getAttribute('href'), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            var html = await response.text();

            Admin.log('[{{ id }}|field_dialog_form_list] retrieving the list content');

            field_dialog_content_{{ id }}.innerHTML = html;
            {% if associationadmin.label is not empty %}
                field_dialog_title_{{ id }}.innerHTML = "{{ associationadmin.label|trans({}, associationadmin.translationdomain) }}";
            {% endif %}

            Admin.shared_setup(field_dialog_{{ id }});
            field_dialog_form_list_handle_action_{{ id }}();

            Admin.showModal(field_dialog_{{ id }});
            Admin.setup_list_modal(field_dialog_{{ id }});
        } catch (error) {
            console.error('[{{ id }}|field_dialog_form_list] Error:', error);
        }
    }

    // Handle the add link
    async function field_dialog_form_add_{{ id }}(event) {
        initialize_popup_{{ id }}();

        event.preventDefault();
        event.stopPropagation();

        var a = event.currentTarget;
        field_dialog_content_{{ id }}.innerHTML = '';

        Admin.log('[{{ id }}|field_dialog_form_add] add link action');

        try {
            var response = await fetch(a.getAttribute('href'), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            var html = await response.text();

            Admin.log('[{{ id }}|field_dialog_form_add] ajax success', field_dialog_{{ id }});

            field_dialog_content_{{ id }}.innerHTML = html;
            {% if associationadmin.label is not empty %}
                field_dialog_title_{{ id }}.innerHTML = "{{ associationadmin.label|trans({}, associationadmin.translationdomain) }}";
            {% endif %}

            Admin.shared_setup(field_dialog_{{ id }});

            field_dialog_{{ id }}.querySelectorAll('a').forEach(function(link) {
                link.addEventListener('click', field_dialog_form_action_{{ id }});
            });
            field_dialog_{{ id }}.querySelectorAll('form').forEach(function(form) {
                form.addEventListener('submit', field_dialog_form_action_{{ id }});
            });

            Admin.showModal(field_dialog_{{ id }});
            Admin.setup_list_modal(field_dialog_{{ id }});
        } catch (error) {
            console.error('[{{ id }}|field_dialog_form_add] Error:', error);
        }
    }

    // Handle the edit link
    async function field_dialog_form_edit_{{ id }}(event) {
        initialize_popup_{{ id }}();

        event.preventDefault();
        event.stopPropagation();

        var a = event.currentTarget;
        field_dialog_content_{{ id }}.innerHTML = '';

        Admin.log('[{{ id }}|field_dialog_form_edit] edit link action');

        try {
            var response = await fetch(a.getAttribute('href'), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            var html = await response.text();

            Admin.log('[{{ id }}|field_dialog_form_edit] ajax success', field_dialog_{{ id }});

            field_dialog_content_{{ id }}.innerHTML = html;
            {% if associationadmin.label is not empty %}
                field_dialog_title_{{ id }}.innerHTML = "{{ associationadmin.label|trans({}, associationadmin.translationdomain) }}";
            {% endif %}

            Admin.shared_setup(field_dialog_{{ id }});

            field_dialog_{{ id }}.querySelectorAll('a').forEach(function(link) {
                link.addEventListener('click', field_dialog_form_action_{{ id }});
            });
            field_dialog_{{ id }}.querySelectorAll('form').forEach(function(form) {
                form.addEventListener('submit', field_dialog_form_action_{{ id }});
            });

            Admin.showModal(field_dialog_{{ id }});
            Admin.setup_list_modal(field_dialog_{{ id }});
        } catch (error) {
            console.error('[{{ id }}|field_dialog_form_edit] Error:', error);
        }
    }

    // Handle form actions
    async function field_dialog_form_action_{{ id }}(event) {
        var element = event.currentTarget;

        // return if the link is an anchor inside the same page
        if (
            element.nodeName === 'A'
            && (
                !element.getAttribute('href')
                || element.getAttribute('href')[0] === '#'
                || element.getAttribute('href').substr(0, 11) === 'javascript:'
            )
        ) {
            Admin.log('[{{ id }}|field_dialog_form_action] element is an anchor or a script, skipping action', element);
            return;
        }

        event.preventDefault();
        event.stopPropagation();

        Admin.log('[{{ id }}|field_dialog_form_action] action catch', element);

        initialize_popup_{{ id }}();

        var url, method;
        if (element.nodeName === 'FORM') {
            url = element.action;
            method = element.method || 'POST';
        } else if (element.nodeName === 'A') {
            url = element.getAttribute('href');
            method = 'GET';
        } else {
            console.error('unexpected element:', element.nodeName);
            return;
        }

        if (element.classList.contains('sonata-ba-action')) {
            Admin.log('[{{ id }}|field_dialog_form_action] reserved action stop catch all events');
            return;
        }

        Admin.log('[{{ id }}|field_dialog_form_action] execute ajax call');

        // Remove old error messages
        field_dialog_content_{{ id }}.querySelectorAll('div.alert-danger').forEach(function(el) {
            el.remove();
        });

        try {
            var fetchOptions = {
                method: method,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            };

            if (element.nodeName === 'FORM') {
                var formData = new FormData(element);
                formData.append('_xml_http_request', 'true');
                fetchOptions.body = formData;
            }

            var response = await fetch(url, fetchOptions);
            var contentType = response.headers.get('Content-Type') || '';
            var data;

            if (contentType.includes('application/json')) {
                data = await response.json();
            } else {
                data = await response.text();
            }

            if (response.ok && typeof data === 'object' && data.result === 'ok') {
                Admin.log('[{{ id }}|field_dialog_form_action] ajax success');

                Admin.hideModal(field_dialog_{{ id }});

                {% if sensiolabs_admin.edit == 'list' %}
                    var input = document.getElementById('{{ id }}');
                    input.value = data.objectId;
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                {% else %}
                    // Reload the form element
                    var form = document.getElementById('field_widget_{{ id }}').closest('form');
                    var formData = new FormData(form);
                    formData.append('_xml_http_request', 'true');

                    var refreshResponse = await fetch('{{ path('sensiolabs_admin_retrieve_form_element', {
                        '_sensiolabs_admin': sensiolabs_admin.admin.root.baseCodeRoute,
                        'elementId': id,
                        'subclass': sensiolabs_admin.admin.hasActiveSubClass() ? sensiolabs_admin.admin.getActiveSubclassCode() : null,
                        'objectId': sensiolabs_admin.admin.root.id(sensiolabs_admin.admin.root.subject),
                        'uniqid': sensiolabs_admin.admin.root.uniqid,
                    } + (
                        sensiolabs_admin.admin.root.hasRequest()
                        ? sensiolabs_admin.admin.root.request.attributes.get('_route_params', {})
                        : {}
                    ) + app.request.query.all|default({})
                    ) }}', {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    var html = await refreshResponse.text();

                    var fieldContainer = document.getElementById('field_container_{{ id }}');
                    var template = document.createElement('template');
                    template.innerHTML = html.trim();
                    var newElement = template.content.firstChild;
                    fieldContainer.parentNode.replaceChild(newElement, fieldContainer);

                    var inputElement = document.querySelector('#{{ id }} [value="' + data.objectId + '"]');
                    if (inputElement) {
                        if (inputElement.tagName === 'INPUT') {
                            inputElement.checked = true;
                        } else {
                            inputElement.selected = true;
                        }
                    }

                    document.getElementById('field_container_{{ id }}').dispatchEvent(
                        new CustomEvent('sonata-admin-append-form-element', { bubbles: true })
                    );
                {% endif %}

                return;
            }

            // Display form error
            field_dialog_content_{{ id }}.innerHTML = typeof data === 'string' ? data : JSON.stringify(data);

            Admin.shared_setup(field_dialog_{{ id }});

            field_dialog_{{ id }}.querySelectorAll('form').forEach(function(form) {
                form.addEventListener('submit', field_dialog_form_action_{{ id }});
            });

        } catch (error) {
            console.error('[{{ id }}|field_dialog_form_action] Error:', error);

            var errorContent = '<div class="alert alert-error">' +
                '<button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>' +
                'An error occurred. Please try again.' +
                '</div>';

            field_dialog_content_{{ id }}.insertAdjacentHTML('afterbegin', errorContent);

            // Re-enable submit buttons
            if (element.nodeName === 'FORM') {
                element.querySelectorAll('button[type="submit"]').forEach(function(btn) {
                    btn.removeAttribute('disabled');
                });
            }
        }

        return false;
    }

    // Initialize popup functions
    window.start_field_dialog_form_add_{{ id }} = function(link) {
        link.onclick = null;
        initialize_popup_{{ id }}();
        link.addEventListener('click', field_dialog_form_add_{{ id }});
        link.click();
        return false;
    };

    window.start_field_dialog_form_edit_{{ id }} = function(link) {
        link.onclick = null;
        initialize_popup_{{ id }}();
        link.addEventListener('click', field_dialog_form_edit_{{ id }});
        link.click();
        return false;
    };

    {% if sensiolabs_admin.edit == 'list' %}
        window.start_field_dialog_form_list_{{ id }} = function(link) {
            link.onclick = null;
            initialize_popup_{{ id }}();
            link.addEventListener('click', field_dialog_form_list_{{ id }});
            link.click();
            return false;
        };

        window.remove_selected_element_{{ id }} = function(link) {
            link.onclick = null;
            link.addEventListener('click', field_remove_element_{{ id }});
            link.click();
            return false;
        };

        function field_remove_element_{{ id }}(event) {
            event.preventDefault();

            var input = document.getElementById('{{ id }}');
            var option = input.querySelector('option:checked');
            if (option) {
                option.selected = false;
            }

            input.value = '';
            input.dispatchEvent(new Event('change', { bubbles: true }));

            return false;
        }

        // Update the label on change
        document.getElementById('{{ id }}').addEventListener('change', async function(event) {
            Admin.log('[{{ id }}|on:change] update the label');

            var objectId = this.value;

            // Skip if object is missing
            if (!objectId) {
                document.getElementById('field_widget_{{ id }}').innerHTML = '{{ 'short_object_description_placeholder'|trans({}, 'SonataAdminBundle') }}';

                {% if btn_edit %}
                    var editBtn = document.querySelector('#field_actions_{{ id }} a.btn-warning');
                    if (editBtn) editBtn.classList.add('hidden');
                {% endif %}

                return;
            }

            document.getElementById('field_widget_{{ id }}').innerHTML = '<span><img src="{{ asset('bundles/sensiolabsadmin/images/ajax-loader.gif') }}" style="vertical-align: middle; margin-right: 10px"/>{{ 'loading_information'|trans([], 'SonataAdminBundle') }}</span>';

            try {
                var response = await fetch('{{ path('sensiolabs_admin_short_object_information',{
                    '_sensiolabs_admin': associationadmin.baseCodeRoute,
                    'objectId': 'OBJECT_ID',
                    'uniqid': associationadmin.uniqid,
                    'linkParameters': sensiolabs_admin.field_description.option('link_parameters', {})
                } + (
                    associationadmin.hasRequest()
                    ? associationadmin.request.attributes.get('_route_params', {})
                    : {}
                ) + app.request.query.all|default({})
                )}}'.replace('OBJECT_ID', objectId), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                var html = await response.text();
                document.getElementById('field_widget_{{ id }}').innerHTML = html;
            } catch (error) {
                console.error('[{{ id }}|on:change] Error:', error);
            }

            {% if btn_edit %}
                var edit_button_url = '{{
                    associationadmin.generateUrl('edit', {(associationadmin.idParameter) : 'OBJECT_ID'})
                }}'.replace('OBJECT_ID', objectId);

                var editBtn = document.querySelector('#field_actions_{{ id }} a.btn-warning');
                if (editBtn) {
                    editBtn.classList.remove('hidden');
                    editBtn.setAttribute('href', edit_button_url);
                }
            {% endif %}
        });
    {% endif %}

    // Initialize if dialog already exists
    if (document.getElementById('field_dialog_{{ id }}')) {
        Admin.shared_setup(document.getElementById('field_dialog_{{ id }}'));
    }
})();
</script>
<!-- / edit many association -->

{% endautoescape %}
