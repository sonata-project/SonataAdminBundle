{#

This code manages the one-to-many association field popup

#}

{% autoescape false %}

<!-- edit one association -->

<script type="text/javascript">
(function() {
    // handle the add link
    var field_add_{{ id }} = async function(event) {
        event.preventDefault();
        event.stopPropagation();

        var form = this.closest('form');
        var formData = new FormData(form);
        formData.append('_xml_http_request', 'true');

        try {
            var response = await fetch('{{ path('sensiolabs_admin_append_form_element', {
                '_sensiolabs_admin': sensiolabs_admin.admin.root.baseCodeRoute,
                'elementId': id,
                'objectId': sensiolabs_admin.admin.root.id(sensiolabs_admin.admin.root.subject),
                'uniqid': sensiolabs_admin.admin.root.uniqid,
            } + sensiolabs_admin.field_description.getOption('link_parameters', {})
            + (
                sensiolabs_admin.admin.root.hasRequest()
                ? sensiolabs_admin.admin.root.request.attributes.get('_route_params', {})
                : {}
            ) + app.request.query.all|default({})
            ) }}', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            var html = await response.text();
            if (!html.length) {
                return;
            }

            var oldForm = document.getElementById('field_container_{{ id }}');
            var template = document.createElement('template');
            template.innerHTML = html.trim();
            var newForm = template.content.firstChild;

            // Maintain state of file inputs
            oldForm.querySelectorAll('input[type="file"]').forEach(function(fileInput) {
                var newFileInput = newForm.querySelector('#' + fileInput.id);
                if (newFileInput) {
                    newFileInput.parentNode.replaceChild(fileInput, newFileInput);
                }
            });

            oldForm.parentNode.replaceChild(newForm, oldForm);

            Admin.shared_setup(document.getElementById('field_container_{{ id }}'));

            if (form.querySelector('input[type="file"]')) {
                form.setAttribute('enctype', 'multipart/form-data');
                form.setAttribute('encoding', 'multipart/form-data');
            }

            var container = document.getElementById('sonata-ba-field-container-{{ id }}');
            if (container) {
                container.dispatchEvent(new CustomEvent('sensiolabs.add_element', { bubbles: true }));
            }

            var fieldContainer = document.getElementById('field_container_{{ id }}');
            if (fieldContainer) {
                fieldContainer.dispatchEvent(new CustomEvent('sensiolabs.add_element', { bubbles: true }));
            }
        } catch (error) {
            console.error('[{{ id }}|field_add] Error:', error);
        }

        return false;
    };

    var field_widget_{{ id }} = false;

    // this function initializes the popup
    // this can be only done this way as popup can be cascaded
    window.start_field_retrieve_{{ id }} = function(link) {
        link.onclick = null;

        // initialize component
        field_widget_{{ id }} = document.getElementById('field_widget_{{ id }}');

        // add the event to the a element
        link.addEventListener('click', field_add_{{ id }});
        link.click();

        return false;
    };
})();
</script>

<!-- / edit one association -->

{% endautoescape %}
