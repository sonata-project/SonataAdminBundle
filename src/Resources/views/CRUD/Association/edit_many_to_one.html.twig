{% if not sensiolabs_admin.field_description.hasassociationadmin %}
    {{ value|render_relation_element(sensiolabs_admin.field_description) }}
{% elseif sensiolabs_admin.edit == 'inline' %}
    {% for field_description in sensiolabs_admin.field_description.associationadmin.formfielddescriptions %}
        {{ form_row(form[field_description.name]) }}
    {% endfor %}
{% else %}
    <div id="field_container_{{ id }}" class="field-container">
        {% if sensiolabs_admin.edit == 'list' %}
            <span id="field_widget_{{ id }}" class="field-short-description">
                {% if sensiolabs_admin.value and sensiolabs_admin.field_description.associationadmin.id(sensiolabs_admin.value) is not null %}
                    {{ render(path('sensiolabs_admin_short_object_information', {
                        '_sensiolabs_admin': sensiolabs_admin.field_description.associationadmin.baseCodeRoute,
                        'objectId': sensiolabs_admin.field_description.associationadmin.id(sensiolabs_admin.value),
                        'uniqid': sensiolabs_admin.field_description.associationadmin.uniqid,
                        'linkParameters': sensiolabs_admin.field_description.option('link_parameters', {})
                    } + (
                        sensiolabs_admin.field_description.associationadmin.hasRequest()
                        ? sensiolabs_admin.field_description.associationadmin.request.attributes.get('_route_params', {})
                        : {}
                    ) + app.request.query.all|default({})
                    )) }}
                {% elseif sensiolabs_admin.field_description.option('placeholder', 'short_object_description_placeholder') %}
                    <span class="inner-field-short-description">
                        {{ sensiolabs_admin.field_description.option('placeholder', 'short_object_description_placeholder')|trans({}, 'SonataAdminBundle') }}
                    </span>
                {% endif %}
            </span>
            <span style="display: none" >
                {{ form_widget(form) }}
            </span>
        {% else %}
            <span id="field_widget_{{ id }}" >
                {{ form_widget(form) }}
            </span>
        {% endif %}

        <div id="field_actions_{{ id }}" class="field-actions">
            {% set display_btn_list = sensiolabs_admin.edit == 'list'
                and sensiolabs_admin.field_description.associationadmin.hasRoute('list')
                and sensiolabs_admin.field_description.associationadmin.hasAccess('list')
                and btn_list %}
            {% set display_btn_add = sensiolabs_admin.edit != 'admin'
                and sensiolabs_admin.field_description.associationadmin.hasRoute('create')
                and sensiolabs_admin.field_description.associationadmin.hasAccess('create')
                and btn_add %}
            {% if display_btn_list or display_btn_add %}
            <div class="btn-group">
                {% if display_btn_list %}
                    <a  href="{{ sensiolabs_admin.field_description.associationadmin.generateUrl('list', {select: true}|merge(sensiolabs_admin.field_description.getOption('link_parameters', {}))) }}"
                        onclick="return start_field_dialog_form_list_{{ id }}(this);"
                        class="btn btn-info btn-sm sonata-ba-action"
                        title="{{
                            btn_translation_domain is same as(false)
                            ? btn_list
                            : btn_list|trans({}, btn_translation_domain)
                        }}"
                        >
                        {{ ux_icon('lucide:list', {class: 'w-4 h-4 inline-block'}) }}
                        {{
                            btn_translation_domain is same as(false)
                            ? btn_list
                            : btn_list|trans({}, btn_translation_domain)
                        }}
                    </a>
                {% endif %}

                {% if display_btn_add %}
                    <a  href="{{ sensiolabs_admin.field_description.associationadmin.generateUrl('create', sensiolabs_admin.field_description.getOption('link_parameters', {})) }}"
                        onclick="return start_field_dialog_form_add_{{ id }}(this);"
                        class="btn btn-success btn-sm sonata-ba-action"
                        title="{{
                            btn_translation_domain is same as(false)
                            ? btn_add
                            : btn_add|trans({}, btn_translation_domain)
                        }}"
                        >
                        {{ ux_icon('lucide:plus-circle', {class: 'w-4 h-4 inline-block'}) }}
                        {{
                            btn_translation_domain is same as(false)
                            ? btn_add
                            : btn_add|trans({}, btn_translation_domain)
                        }}
                    </a>
                {% endif %}
            </div>
            {% endif %}

            {% set display_btn_delete = sensiolabs_admin.edit == 'list'
                and sensiolabs_admin.field_description.associationadmin.hasRoute('delete')
                and sensiolabs_admin.field_description.associationadmin.hasAccess('delete')
                and btn_delete %}
            {% if display_btn_delete %}
                <a  href=""
                    onclick="return remove_selected_element_{{ id }}(this);"
                    class="btn btn-danger btn-sm sonata-ba-action"
                    title="{{
                        btn_translation_domain is same as(false)
                        ? btn_delete
                        : btn_delete|trans({}, btn_translation_domain)
                    }}"
                    >
                    {{ ux_icon('lucide:minus-circle', {class: 'w-4 h-4 inline-block'}) }}
                    {{
                        btn_translation_domain is same as(false)
                        ? btn_delete
                        : btn_delete|trans({}, btn_translation_domain)
                    }}
                </a>
            {% endif %}

            {% if display_btn_list or display_btn_add or display_btn_delete %}
                {% include '@SensioLabsAdmin/CRUD/Association/edit_modal.html.twig' %}
                {% include '@SensioLabsAdmin/CRUD/Association/edit_many_script.html.twig' %}
            {% endif %}
        </div>
    </div>
{% endif %}
