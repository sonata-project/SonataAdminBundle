{% if not sensiolabs_admin.field_description.hasassociationadmin %}
    {% for element in value %}
        {{ element|render_relation_element(sensiolabs_admin.field_description) }}
    {% endfor %}
{% else %}

    <div id="field_container_{{ id }}" class="field-container">
        <span id="field_widget_{{ id }}" >
            {% if sensiolabs_admin.edit == 'inline' %}
                {% if sensiolabs_admin.inline == 'table' %}
                    {% if form.children|length > 0 %}
                        {% include '@SensioLabsAdmin/CRUD/Association/edit_one_to_many_inline_table.html.twig' %}
                    {% endif %}
                {% elseif form.children|length > 0 %}
                    {% set associationAdmin = sensiolabs_admin.field_description.associationadmin %}
                    {% include '@SensioLabsAdmin/CRUD/Association/edit_one_to_many_inline_tabs.html.twig' %}

                {% endif %}
            {% else %}
                {{ form_widget(form) }}
            {% endif %}

        </span>

        {% set display_create_button = sensiolabs_admin.field_description.associationadmin.hasRoute('create')
            and sensiolabs_admin.field_description.associationadmin.hasAccess('create')
            and btn_add
            and (
                sensiolabs_admin.field_description.option('limit') is null or
                form.children|length < sensiolabs_admin.field_description.option('limit')
            ) %}

        {% if sensiolabs_admin.edit == 'inline' %}

            {% if display_create_button %}
                <span id="field_actions_{{ id }}" >
                    <a
                        href="{{ sensiolabs_admin.field_description.associationadmin.generateUrl(
                            'create',
                            sensiolabs_admin.field_description.getOption('link_parameters', {})
                        ) }}"
                        onclick="return start_field_retrieve_{{ id }}(this);"
                        class="btn btn-success btn-sm sonata-ba-action"
                        title="{{
                            btn_translation_domain is same as(false)
                            ? btn_add
                            : btn_add|trans({}, btn_translation_domain)
                        }}"
                    >
                        {{ ux_icon('lucide:plus-circle', {class: 'w-4 h-4 inline-block'}) }}
                        {{
                            btn_translation_domain is same as(false)
                            ? btn_add
                            : btn_add|trans({}, btn_translation_domain)
                        }}
                    </a>
                </span>
            {% endif %}

            {# add code for the sortable options #}
            {% if sensiolabs_admin.field_description.option('sortable', false) %}
                {% if sensiolabs_admin.inline == 'table' %}
                    {% include '@SensioLabsAdmin/CRUD/Association/edit_one_to_many_sortable_script_table.html.twig' %}
                {% else %}
                    {% include '@SensioLabsAdmin/CRUD/Association/edit_one_to_many_sortable_script_tabs.html.twig' %}
                {% endif %}
            {% endif %}

            {# include association code #}
            {% include '@SensioLabsAdmin/CRUD/Association/edit_one_script.html.twig' %}

        {% else %}
            <span id="field_actions_{{ id }}" >
                {% if display_create_button %}
                    <a
                        href="{{ sensiolabs_admin.field_description.associationadmin.generateUrl(
                            'create',
                            sensiolabs_admin.field_description.getOption('link_parameters', {})
                        ) }}"
                        onclick="return start_field_dialog_form_add_{{ id }}(this);"
                        class="btn btn-success btn-sm sonata-ba-action"
                        title="{{
                            btn_translation_domain is same as(false)
                            ? btn_add
                            : btn_add|trans({}, btn_translation_domain)
                        }}"
                    >
                        {{ ux_icon('lucide:plus-circle', {class: 'w-4 h-4 inline-block'}) }}
                        {{
                            btn_translation_domain is same as(false)
                            ? btn_add
                            : btn_add|trans({}, btn_translation_domain)
                        }}
                    </a>
                    {% include '@SensioLabsAdmin/CRUD/Association/edit_modal.html.twig' %}
                    {% include '@SensioLabsAdmin/CRUD/Association/edit_many_script.html.twig' %}
                {% endif %}
            </span>
        {% endif %}
    </div>
{% endif %}
