{% extends '@SensioLabsAdmin/empty_layout.html.twig' %}

{% block content %}
    <div class="flex min-h-screen items-center justify-center bg-gray-50 dark:bg-gray-900 px-4 py-12 sm:px-6 lg:px-8">
        <div class="w-full max-w-md space-y-8">
            <div class="text-center">
                <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-100 dark:bg-green-900/30">
                    {{ ux_icon('lucide:mail-check', {class: 'h-6 w-6 text-green-600 dark:text-green-400'}) }}
                </div>
                <h2 class="mt-4 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    {{ 'resetting.check_email'|trans({'%tokenLifetime%': (token_ttl / 3600)|round}, 'SensioLabsAdminBundle') }}
                </h2>
            </div>

            <div class="text-center">
                <a href="{{ path('sensiolabs_admin_user_security_login') }}" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    {{ 'security.login.submit'|trans({}, 'SensioLabsAdminBundle') }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
