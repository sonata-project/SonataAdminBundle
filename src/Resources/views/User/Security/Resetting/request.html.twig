{% extends '@SensioLabsAdmin/empty_layout.html.twig' %}

{% block content %}
    <div class="flex min-h-screen items-center justify-center bg-gray-50 dark:bg-gray-900 px-4 py-12 sm:px-6 lg:px-8">
        <div class="w-full max-w-md space-y-8">
            <div class="text-center">
                <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
                    {{ 'resetting.request.title'|trans({}, 'SensioLabsAdminBundle') }}
                </h2>
            </div>

            <form action="{{ path('sensiolabs_admin_user_resetting_send_email') }}" method="post" class="space-y-6">
                <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                        {{ 'resetting.request.email'|trans({}, 'SensioLabsAdminBundle') }}
                    </label>
                    <div class="mt-1">
                        <input id="email" name="email" type="email" autocomplete="email" required
                               class="block w-full rounded-md border-gray-300 shadow-sm focus:border-primary-500 focus:ring-primary-500 sm:text-sm dark:bg-gray-800 dark:border-gray-600 dark:text-white">
                    </div>
                </div>

                <div>
                    <button type="submit"
                            class="flex w-full justify-center rounded-md border border-transparent bg-primary-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2">
                        {{ 'resetting.request.submit'|trans({}, 'SensioLabsAdminBundle') }}
                    </button>
                </div>
            </form>

            <div class="text-center">
                <a href="{{ path('sensiolabs_admin_user_security_login') }}" class="text-sm font-medium text-primary-600 hover:text-primary-500">
                    {{ 'security.login.submit'|trans({}, 'SensioLabsAdminBundle') }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
