{% if security_roles is not empty %}
    <div class="space-y-2">
        {% for role, attributes in security_roles %}
            {% if form[role] is defined %}
                <div class="flex items-center gap-2">
                    {{ form_widget(form[role]) }}
                    <label class="text-sm text-gray-700 dark:text-gray-300">
                        {{ role }}
                        {% if attributes.is_granted %}
                            <span class="ml-1 inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">
                                granted
                            </span>
                        {% endif %}
                    </label>
                </div>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
