{% extends get_global_template('layout') %}

{% block sensiolabs_header %}{% endblock %}
{% block sensiolabs_left_side %}{% endblock %}
{% block sensiolabs_breadcrumb %}{% endblock %}

{% block body_attributes -%}
    class="min-h-screen bg-white"
{%- endblock -%}

{% block sensiolabs_wrapper %}
    <main class="min-h-screen">
        {% block sensiolabs_page_content %}
            <div class="p-4">
                {% block sensiolabs_admin_content %}
                    {% block notice %}
                        {% include '@SensioLabsAdmin/FlashMessage/render.html.twig' %}
                    {% endblock notice %}

                    {% set _content = block('content') is defined ? block('content')|trim : null %}
                    {% if _content is not empty %}
                        {{ _content|raw }}
                    {% endif %}
                {% endblock sensiolabs_admin_content %}
            </div>
        {% endblock %}
    </main>
{% endblock %}
