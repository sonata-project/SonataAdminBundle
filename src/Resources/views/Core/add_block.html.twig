{# Add dropdown - shows menu items that link to crud create actions #}
{% set menu_items = sensiolabs_admin_menu_items() %}

{% set has_create_items = false %}
{% for item in menu_items %}
    {% if item.type == 'crud' and item.adminCode %}
        {% set has_create_items = true %}
    {% endif %}
{% endfor %}

{% if has_create_items %}
<div class="py-1">
    {% for item in menu_items %}
        {% if item.type == 'crud' and item.adminCode %}
            <a href="{{ sensiolabs_admin_menu_item_url(item)|replace({'list': 'create'}) }}" class="dropdown-item flex items-center gap-2">
                {% if item.icon %}
                    <span class="icon-sm text-gray-400">{{ item.icon|parse_icon|raw }}</span>
                {% else %}
                    {{ ux_icon('lucide:plus', {class: 'icon-sm text-gray-400'}) }}
                {% endif %}
                <span>{{ item.label|trans({}, 'SensioLabsAdminBundle') }}</span>
            </a>
        {% endif %}
    {% endfor %}
</div>
{% endif %}
