{% extends base_template %}

{% block title %}{{ dashboard_content.title|default('Dashboard')|trans({}, 'SensioLabsAdminBundle') }}{% endblock %}
{% block breadcrumb %}{% endblock %}

{% block content %}
    <div class="space-y-6">
        {% block dashboard_content %}
            {# Welcome Header #}
            <div class="admin-card">
                <div class="p-6 bg-gradient-to-r from-primary-500 to-primary-600 rounded-xl text-white">
                    <div class="flex items-center justify-between">
                        <div>
                            <h1 class="text-2xl font-bold mb-1">
                                {% if app.user %}
                                    {{ 'welcome_back'|trans({'%name%': app.user.userIdentifier|default('Admin')}, 'SensioLabsAdminBundle') }}
                                {% else %}
                                    {{ dashboard_content.title|default('Dashboard')|trans({}, 'SensioLabsAdminBundle') }}
                                {% endif %}
                            </h1>
                            <p class="text-primary-100">{{ 'dashboard_subtitle'|trans({}, 'SensioLabsAdminBundle') }}</p>
                        </div>
                        <div class="hidden md:block">
                            {{ ux_icon('lucide:bar-chart-3', {class: 'w-16 h-16 text-white/20'}) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Quick Stats - Example placeholder #}
            {% if dashboard_content.stats is defined %}
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    {% for stat in dashboard_content.stats %}
                        <div class="admin-stat-card">
                            <div class="admin-stat-card-header">
                                <div class="admin-stat-card-icon admin-stat-card-icon-{{ stat.color|default('primary') }}">
                                    {{ ux_icon(stat.icon|default('lucide:bar-chart-3'), {class: 'w-5 h-5'}) }}
                                </div>
                            </div>
                            <div class="admin-stat-card-value">{{ stat.value }}</div>
                            <div class="admin-stat-card-label">{{ stat.label|trans({}, 'SensioLabsAdminBundle') }}</div>
                            {% if stat.trend is defined %}
                                <div class="admin-stat-card-trend admin-stat-card-trend-{{ stat.trend > 0 ? 'up' : 'down' }}">
                                    {{ ux_icon(stat.trend > 0 ? 'lucide:trending-up' : 'lucide:trending-down', {class: 'w-4 h-4'}) }}
                                    {{ stat.trend|abs }}%
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {# Dashboard Widgets #}
            {% if dashboard_content.widgets is defined %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for widget in dashboard_content.widgets %}
                        <div class="{{ widget.class|default('') }}">
                            {{ include(widget.template, widget.parameters|default({})) }}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {# Quick Access - Admin groups #}
            {% if sensiolabs_admin_groups is defined and sensiolabs_admin_groups|length > 0 %}
                <div class="admin-card">
                    <div class="admin-card-header">
                        <h2 class="admin-card-header-title">{{ 'quick_access'|trans({}, 'SensioLabsAdminBundle') }}</h2>
                    </div>
                    <div class="admin-card-body">
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                            {% for group in sensiolabs_admin_groups %}
                                {% for admin in group.items %}
                                    {% if admin.hasRoute('list') and admin.hasAccess('list') %}
                                        <a href="{{ admin.generateUrl('list') }}" class="flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-primary-300 hover:bg-primary-50/50 transition-all duration-200 group">
                                            <div class="w-10 h-10 rounded-lg bg-primary-100 text-primary-600 flex items-center justify-center group-hover:bg-primary-500 group-hover:text-white transition-colors">
                                                {{ ux_icon(admin.icon|default('lucide:layers'), {class: 'w-5 h-5'}) }}
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <div class="font-medium text-gray-900 truncate">{{ admin.label|trans({}, admin.translationDomain) }}</div>
                                                <div class="text-sm text-gray-500">{{ 'manage'|trans({}, 'SensioLabsAdminBundle') }}</div>
                                            </div>
                                            {{ ux_icon('lucide:chevron-right', {class: 'w-5 h-5 text-gray-400 group-hover:text-primary-500 transition-colors'}) }}
                                        </a>
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
