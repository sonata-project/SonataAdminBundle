        "importmap": {
            "@hotwired/stimulus": "^3.2.0",
            "tom-select": "^2.3.0",
            "sortablejs": "^1.15.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.2.0",
        "tom-select": "^2.3.0",
        "sortablejs": "^1.15.0"
