{
    "name": "@sensiolabs-de/admin-bundle",
    "version": "5.0.0",
    "description": "SensioLabs Admin Bundle - Assets for Symfony Admin",
    "license": "MIT",
    "type": "module",
    "main": "app.js",
    "symfony": {
        "controllers": {
            "collection": {
                "main": "./js/controllers/collection_controller.js",
