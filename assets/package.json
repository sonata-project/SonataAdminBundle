            "confirm-exit": {
                "main": "./js/controllers/confirm_exit_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "dropdown": {
                "main": "./js/controllers/dropdown_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "edit": {
                "main": "./js/controllers/edit_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "filter": {
                "main": "./js/controllers/filter_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "filter-list": {
                "main": "./js/controllers/filter_list_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "per-page": {
                "main": "./js/controllers/per_page_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "readmore": {
                "main": "./js/controllers/readmore_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "revision": {
                "main": "./js/controllers/revision_controller.js",
                "fetch": "eager",
                "enabled": true
